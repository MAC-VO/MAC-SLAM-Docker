ARG BASE_IMAGE="nvcr.io/nvidia/pytorch:25.06-py3"

# STAGE 1: The Heavy Source
# We mount this only to "rob" it of its python source files
FROM ${BASE_IMAGE} AS base

WORKDIR /export

# Build a lightweight type-stub skeleton of site-packages for Pyright:
#   1. Copy the real typed sources verbatim — .py / .pyi (types), plus .pth (namespace
#      packages) and .json (library configs) — preserving the folder structure.
#   2. Materialize every compiled extension (.so) as a ZERO-BYTE placeholder. Pyright never
#      reads the binary; it only needs the module file to exist so a package-level re-export
#      backed by a native/Cython module resolves instead of erroring with "unknown import
#      symbol" (e.g. scipy.sparse.csgraph -> reverse_cuthill_mckee, scipy.spatial.transform
#      -> Rotation). Empty placeholders keep the image small while covering every native API.
# '__pycache__' is excluded throughout.
RUN SITE_PACKAGES=$(python -c "import site; print(site.getsitepackages()[0])") && \
    mkdir -p /export/site-packages && \
    cd "$SITE_PACKAGES" && \
    find . -type f \( -name "*.py" -o -name "*.pyi" -o -name "*.pth" -o -name "*.json" \) \
        -not -path "*/__pycache__/*" \
        -exec cp --parents "{}" /export/site-packages/ \; && \
    find . -type f -name "*.so" -not -path "*/__pycache__/*" -printf '%P\0' | \
        xargs -0 -I{} sh -c 'p="$1"; mkdir -p "/export/site-packages/$(dirname "$p")" && : > "/export/site-packages/$p"' _ {}

    
# STAGE 2: The Lightweight CI Runner
FROM python:3.12-slim

WORKDIR /workspace

# Install Pyright
RUN apt-get update && apt-get install -y libatomic1 git && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir pyright

# Copy the "Skeleton" libraries from the heavy image
# We place them in the standard site-packages of this new container
COPY --from=base /export/site-packages /usr/local/lib/python3.12/site-packages

# Run Pyright
CMD ["pyright"]
